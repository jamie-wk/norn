{
  "name": "@norn/example-orders-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Example Norn worker: orders, payments, shipping and loyalty.",
  "scripts": {
    "gen": "norn gen",
    "build": "norn gen && tsc -p tsconfig.build.json && norn bundle --out dist/workflow-bundle.js",
    "start": "NORN_WORKFLOW_BUNDLE=dist/workflow-bundle.js node dist/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "gen:check": "norn gen --check"
  },
  "dependencies": {
    "@norn/activity": "workspace:^",
    "@norn/client": "workspace:^",
    "@norn/codec": "workspace:^",
    "@norn/core": "workspace:^",
    "@norn/worker": "workspace:^",
    "@norn/workflow": "workspace:^",
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/common": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0"
  },
  "devDependencies": {
    "@norn/cli": "workspace:^",
    "@norn/testing": "workspace:^",
    "@temporalio/testing": "1.24.0"
  }
}
