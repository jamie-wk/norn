{
  "name": "@norn/worker",
  "version": "1.0.0",
  "description": "createWorker(): registration, bundling, versioning, graceful drain and health checks for Norn workers.",
  "license": "MIT",
  "type": "module",
  "author": "Jamie King",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamie-wk/norn.git",
    "directory": "packages/worker"
  },
  "homepage": "https://jamie-wk.github.io/norn/",
  "bugs": "https://github.com/jamie-wk/norn/issues",
  "keywords": [
    "temporal",
    "workflow",
    "durable-execution",
    "typescript",
    "decorators",
    "norn"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "@norn/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./workflow-interceptors": {
      "@norn/source": "./src/workflow-interceptors.ts",
      "types": "./dist/workflow-interceptors.d.ts",
      "default": "./dist/workflow-interceptors.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@norn/core": "workspace:^",
    "@norn/activity": "workspace:^"
  },
  "peerDependencies": {
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "@temporalio/activity": "^1.24.0",
    "@temporalio/common": "^1.24.0",
    "@temporalio/client": "^1.24.0"
  },
  "devDependencies": {
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "@temporalio/activity": "1.24.0",
    "@temporalio/common": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/testing": "1.24.0",
    "@temporalio/interceptors-opentelemetry": "1.24.0",
    "@norn/workflow": "workspace:^",
    "@norn/client": "workspace:^",
    "@norn/testing": "workspace:^",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@norn/codec": "workspace:^"
  }
}
