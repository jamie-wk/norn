{
  "name": "@norn-ts/norn",
  "version": "2.0.0",
  "description": "Write Temporal workflows and activities as plain, typed TypeScript classes.",
  "license": "MIT",
  "type": "module",
  "author": "Jamie King",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamie-wk/norn.git",
    "directory": "packages/norn"
  },
  "homepage": "https://jamie-wk.github.io/norn/",
  "bugs": "https://github.com/jamie-wk/norn/issues",
  "keywords": [
    "temporal",
    "workflow",
    "durable-execution",
    "typescript",
    "decorators",
    "norn"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "@norn/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./workflow": {
      "@norn/source": "./src/workflow/index.ts",
      "types": "./dist/workflow/index.d.ts",
      "default": "./dist/workflow/index.js"
    },
    "./client": {
      "@norn/source": "./src/client/index.ts",
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./worker": {
      "@norn/source": "./src/worker/index.ts",
      "types": "./dist/worker/index.d.ts",
      "default": "./dist/worker/index.js"
    },
    "./testing": {
      "@norn/source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./vitest": {
      "@norn/source": "./src/testing/vitest.ts",
      "types": "./dist/testing/vitest.d.ts",
      "default": "./dist/testing/vitest.js"
    },
    "./vite": {
      "@norn/source": "./src/testing/vite.ts",
      "types": "./dist/testing/vite.d.ts",
      "default": "./dist/testing/vite.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@temporalio/client": "^1.24.0",
    "@temporalio/common": "^1.24.0",
    "@temporalio/testing": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "esbuild": ">=0.21",
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "@temporalio/testing": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/common": "1.24.0",
    "@temporalio/testing": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "esbuild": "0.28.2",
    "vitest": "5.0.5"
  }
}
