    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0"
  },
  "devDependencies": {
    "@norn-ts/cli": "^{{version}}",
    "@norn-ts/testing": "^{{version}}",
    "@temporalio/testing": "^1.24.0",
    "@types/node": "^22.18.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
