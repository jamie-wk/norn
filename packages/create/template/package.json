{
  "name": "{{name}}",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "order": "tsx src/order.ts",
    "build": "esbuild src/worker.ts src/workflows/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outdir=dist",
    "start": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@norn-ts/norn": "^{{version}}",
    "@temporalio/client": "^1.24.0",
    "@temporalio/common": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0"
  },
  "devDependencies": {
    "@temporalio/testing": "^1.24.0",
    "@types/node": "^22.18.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@swc/core", "@temporalio/core-bridge", "esbuild", "protobufjs"]
  }
}
