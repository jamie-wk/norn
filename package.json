{
  "name": "norn-monorepo",
  "private": true,
  "type": "module",
  "description": "Norn: typed, decorator-driven Temporal workflows for TypeScript.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "build:all": "pnpm -r build",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "oxlint --deny-warnings packages examples e2e tooling",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:e2e": "pnpm --filter @norn/e2e test",
    "gen:check": "pnpm -r --if-present gen:check",
    "check:deps": "node tooling/check-deps.mjs",
    "check:pack": "node tooling/check-pack.mjs",
    "docs:dev": "pnpm --filter @norn/docs dev",
    "docs:build": "pnpm --filter @norn/docs build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "3.0.3",
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/common": "1.24.0",
    "@temporalio/testing": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "@types/node": "^22.18.0",
    "esbuild": "0.28.2",
    "oxlint": "1.88.0",
    "publint": "0.3.25",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
